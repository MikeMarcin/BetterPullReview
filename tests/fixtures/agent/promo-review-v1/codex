#!/usr/bin/env python3
"""Replay the two scoped agent turns in the BetterPullReview promo."""

import hashlib
import json
import sys
from pathlib import Path

EXPECTED_CONTEXT = {
    "pull_request_url": "https://github.com/bpr-demo/lantern/pull/512",
    "base": "c8d078714e30667585ceffdf7f4c20d9131cd4a2",
    "head": "069cbf66992b253bf0bd73ed3e46e4a8019a0dc8",
    "private.count": "0",
}
PROMPT_SHA256 = "d4fa220c2497d5b5d8700b322e0ce627294e9ee8d49245d7f2e3250f9d7163c8"
REVISION_CONTEXT = {
    "pull_request_url": "https://github.com/bpr-fixtures/nested-folders/pull/21",
    "private.count": "0",
    "chat_message": "What changed since my review",
    "returning.operation": "latest_upload",
    "returning.basis": "review",
    "returning.earlier_head": "b20cb443428212543f5911e091a0ffeb407d23cf",
    "returning.current_head": "cd24836cfb58a9c14f4d3464d68a57ff8aa2a186",
    "head": "cd24836cfb58a9c14f4d3464d68a57ff8aa2a186",
}
REVISION_DIFF_SHA256 = "a21368e0a4afebea6b0391edfd625645a3154ec155861295e066417f87c4c5dc"


def matches(fields, expected):
    return all(fields.get(key) == value for key, value in expected.items())


def emit(event):
    print(json.dumps(event, ensure_ascii=False), flush=True)


def main(arguments):
    if arguments == ["--version"]:
        print("codex-cli 0.167.0 (recorded promo fixture)")
        return 0
    if arguments == ["login", "status"]:
        print("Logged in using the recorded promo fixture")
        return 0
    if not arguments or arguments[0] != "exec" or "--json" not in arguments:
        return 64

    lines = sys.stdin.read().splitlines()
    if not lines or lines[0] != "BPR-CONTEXT/2 CODEX-EXEC":
        return 65
    fields = dict(line.split("\t", 1) for line in lines[1:] if "\t" in line)
    prompt = fields.get("chat_message", "").encode("utf-8")
    changes = fields.get("returning.changes", "").encode("utf-8")
    completion = {"type": "turn.completed"}
    if matches(fields, EXPECTED_CONTEXT) and hashlib.sha256(prompt).hexdigest() == PROMPT_SHA256:
        filename = "review.md"
        item_id = "review"
        thread_id = "00000000-0000-4000-8000-000000000512"
        completion["usage"] = {
            "input_tokens": 114824,
            "cached_input_tokens": 90368,
            "cache_write_input_tokens": 0,
            "output_tokens": 1612,
            "reasoning_output_tokens": 111,
        }
    elif matches(fields, REVISION_CONTEXT) and hashlib.sha256(changes).hexdigest() == REVISION_DIFF_SHA256:
        filename = "revision-answer.md"
        item_id = "returning-review"
        thread_id = "00000000-0000-4000-8000-000000000021"
        completion["usage"] = {"input_tokens": 0, "cached_input_tokens": 0, "output_tokens": 0}
    else:
        print("The request does not match a recorded promo turn.", file=sys.stderr)
        return 65

    answer = Path(__file__).with_name(filename).read_text(encoding="utf-8")
    emit({"type": "thread.started", "thread_id": thread_id})
    emit({"type": "turn.started"})
    emit({"type": "item.completed", "item": {"type": "agent_message", "id": item_id, "text": answer}})
    emit(completion)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
