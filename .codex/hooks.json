{
  "description": "Validate remote-station tasks and guard checkout mutation for the implement-rfc skill.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/skills/implement-rfc/scripts/remote_station_guard.py\"",
            "command_windows": "py -3 -c \"import pathlib,runpy,subprocess; r=subprocess.check_output(['git','rev-parse','--show-toplevel'], text=True).strip(); runpy.run_path(str(pathlib.Path(r)/'.agents/skills/implement-rfc/scripts/remote_station_guard.py'), run_name='__main__')\"",
            "timeout": 10,
            "statusMessage": "Validating remote station task"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/skills/implement-rfc/scripts/remote_station_guard.py\"",
            "command_windows": "py -3 -c \"import pathlib,runpy,subprocess; r=subprocess.check_output(['git','rev-parse','--show-toplevel'], text=True).strip(); runpy.run_path(str(pathlib.Path(r)/'.agents/skills/implement-rfc/scripts/remote_station_guard.py'), run_name='__main__')\"",
            "timeout": 10,
            "statusMessage": "Checking remote station authority"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/skills/implement-rfc/scripts/remote_station_guard.py\"",
            "command_windows": "py -3 -c \"import pathlib,runpy,subprocess; r=subprocess.check_output(['git','rev-parse','--show-toplevel'], text=True).strip(); runpy.run_path(str(pathlib.Path(r)/'.agents/skills/implement-rfc/scripts/remote_station_guard.py'), run_name='__main__')\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
