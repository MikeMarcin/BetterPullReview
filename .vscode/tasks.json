{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure (app-release)",
      "detail": "cmake --preset app-release",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "app-release"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "CMake: build (app-release)",
      "detail": "cmake --build --preset app-release",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "app-release"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CMake: configure + build (app-release)",
      "detail": "cmake --workflow --preset app-release",
      "type": "process",
      "command": "cmake",
      "args": ["--workflow", "--preset", "app-release"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
