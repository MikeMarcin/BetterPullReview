{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://implement-rfc.local/schemas/remote-task-envelope.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope",
    "task_id",
    "project",
    "station",
    "workstream",
    "branch",
    "rfcs",
    "cards",
    "rfc_base_sha",
    "base_commit",
    "authority",
    "id_reservations",
    "reply_to",
    "done_when"
  ],
  "properties": {
    "envelope": {"const": "implement-rfc.remote-task.v1"},
    "task_id": {"type": "string", "pattern": "^task-[0-9a-z-]{4,64}$"},
    "project": {"$ref": "#/$defs/token"},
    "station": {"$ref": "#/$defs/sessionName"},
    "workstream": {"$ref": "#/$defs/token"},
    "branch": {"$ref": "#/$defs/branchName"},
    "checkout": {"type": "string", "maxLength": 4096},
    "rfcs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/rfcId"}
    },
    "cards": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/cardId"}
    },
    "rfc_base_sha": {"$ref": "#/$defs/sha40"},
    "base_commit": {"$ref": "#/$defs/sha40"},
    "authority": {"enum": ["lane-commit", "read-only-proof"]},
    "id_reservations": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/reservation"}
    },
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "reply_to": {"$ref": "#/$defs/sessionName"},
    "done_when": {"type": "string", "minLength": 1, "maxLength": 512},
    "notes": {"type": "string", "maxLength": 4096}
  },
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "token": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "sessionName": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$"},
    "branchName": {"type": "string", "pattern": "^[A-Za-z0-9._/-]{1,255}$"},
    "rfcId": {"type": "string", "pattern": "^RFC-[A-Z]{2,8}-[0-9]{4}$"},
    "cardId": {"type": "string", "pattern": "^[A-Z]{2,8}-[0-9]{4}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reservation_id", "area", "range", "reservation_commit"],
      "properties": {
        "reservation_id": {"type": "string", "pattern": "^idr-[a-z0-9-]{4,64}$"},
        "area": {"type": "string", "pattern": "^[A-Z]{2,8}$"},
        "range": {"type": "string", "pattern": "^[A-Z]{2,8}-[0-9]{4}\\.\\.[A-Z]{2,8}-[0-9]{4}$"},
        "reservation_commit": {"$ref": "#/$defs/sha40"}
      }
    }
  }
}
