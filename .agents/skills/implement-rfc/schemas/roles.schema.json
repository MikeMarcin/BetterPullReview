{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://implement-rfc.local/schemas/roles.v1.json",
  "type": "object",
  "required": [
    "schema",
    "roles"
  ],
  "properties": {
    "schema": {
      "const": "implement-rfc.roles.v1"
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "description",
          "mutation",
          "max_turns",
          "instructions"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "mutation": {
            "enum": [
              "read-only",
              "build-write",
              "workspace-write"
            ]
          },
          "max_turns": {
            "type": "integer",
            "minimum": 1
          },
          "may_spawn_utility": {
            "type": "boolean"
          },
          "instructions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
