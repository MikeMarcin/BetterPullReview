include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/AitoCpm.cmake")

# [[BPR-1434]]. utf8proc for the functional core's Unicode work (UTF-8
# decoding, canonical decomposition and case mapping), one of the
# owner-approved core libraries (2026-10-13). Only utf8proc.c is compiled,
# as a static library: no upstream build, tests or install rules.
function(bpr_acquire_utf8proc)
    if(TARGET BetterPullReview::UTF8Proc OR TARGET better_pull_review_utf8proc)
        message(FATAL_ERROR "utf8proc target must be owned by the pinned provider")
    endif()
    if(DEFINED FETCHCONTENT_SOURCE_DIR_BPRUTF8PROC)
        if(NOT "${FETCHCONTENT_SOURCE_DIR_BPRUTF8PROC}" STREQUAL "")
            message(FATAL_ERROR "utf8proc source substitution is forbidden")
        endif()
    endif()
    bpr_load_cpm()
    set(archive "${CPM_SOURCE_CACHE}/utf8proc-2.12.0.tar.gz")
    set(digest "f564011d38b2888d583d510b08e69ffa15aa117155db1b9b49ef1dfe1fa25111")
    file(LOCK "${archive}.lock" GUARD FUNCTION TIMEOUT 120)
    if(NOT EXISTS "${archive}")
        if(BPR_DEPENDENCY_OFFLINE)
            message(FATAL_ERROR "Offline mode requires cached utf8proc 2.12.0 archive")
        endif()
        file(DOWNLOAD "https://codeload.github.com/JuliaStrings/utf8proc/tar.gz/refs/tags/v2.12.0"
             "${archive}" EXPECTED_HASH "SHA256=${digest}" TLS_VERIFY ON)
    endif()
    file(SHA256 "${archive}" actual)
    file(SIZE "${archive}" bytes)
    if(NOT actual STREQUAL digest OR NOT bytes EQUAL 207976)
        message(FATAL_ERROR "utf8proc archive does not match pinned 2.12.0")
    endif()
    # Re-extract the verified archive: never trust an editable cached source tree.
    set(stage "${CMAKE_BINARY_DIR}/_bpr/utf8proc")
    file(REMOVE_RECURSE "${stage}")
    file(MAKE_DIRECTORY "${stage}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${stage}")
    set(source "${stage}/utf8proc-2.12.0")
    file(SHA256 "${source}/LICENSE.md" license_digest)
    if(NOT license_digest STREQUAL "3b510150d34f248a221bb88e1d811238d6c6c18b51231822c42974c39bb07256")
        message(FATAL_ERROR "utf8proc license does not match the pinned notice")
    endif()
    add_library(better_pull_review_utf8proc STATIC "${source}/utf8proc.c")
    add_library(BetterPullReview::UTF8Proc ALIAS better_pull_review_utf8proc)
    target_include_directories(better_pull_review_utf8proc SYSTEM PUBLIC "${source}")
    target_compile_definitions(better_pull_review_utf8proc PUBLIC UTF8PROC_STATIC)
    set_target_properties(better_pull_review_utf8proc PROPERTIES POSITION_INDEPENDENT_CODE ON)
endfunction()
