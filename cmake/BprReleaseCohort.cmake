# [[BPR-1799]]. Producers consume one frozen release cohort; configure never allocates.
set(BPR_RELEASE_COHORT "" CACHE FILEPATH "External frozen publish-release cohort JSON (empty for local builds)")
set(BPR_RELEASE_PRODUCER "" CACHE STRING "Declared producer in the frozen release cohort")
set(BPR_RELEASE_BUILD_NUMBER 0)
set(BPR_RELEASE_CONFIGURATION_DIGEST "")
set(BPR_RELEASE_COHORT_DIGEST "")
set(BPR_RELEASE_DISPLAY_VERSION "${PROJECT_VERSION}")
set(BPR_RELEASE_ASSET_VERSION "${PROJECT_VERSION}")
set(BPR_RELEASE_MAC_VERSION "${PROJECT_VERSION}")
set(BPR_RELEASE_MSI_VERSION "${PROJECT_VERSION}")
set(BPR_RELEASE_DEBIAN_VERSION "${PROJECT_VERSION}")
set(BPR_RELEASE_JSON "null")
set(bpr_release_type "${CMAKE_BUILD_TYPE}")
if(CMAKE_CONFIGURATION_TYPES)
    list(LENGTH CMAKE_CONFIGURATION_TYPES bpr_release_configuration_count)
    if(BPR_RELEASE_COHORT AND NOT bpr_release_configuration_count EQUAL 1)
        message(FATAL_ERROR "A numbered producer selects exactly one native configuration")
    endif()
    set(bpr_release_type "${CMAKE_CONFIGURATION_TYPES}")
endif()
set(bpr_release_architectures "${CMAKE_SYSTEM_PROCESSOR}")
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    set(bpr_release_architectures "${CMAKE_OSX_ARCHITECTURES}")
endif()
list(JOIN bpr_release_architectures "\",\"" bpr_release_architectures)
set(bpr_release_options "")
get_cmake_property(bpr_release_cache_variables CACHE_VARIABLES)
set(bpr_release_option_names BUILD_TESTING BPR_EXTERNAL_QT_RESOURCES)
foreach(variable IN LISTS bpr_release_cache_variables)
    get_property(kind CACHE "${variable}" PROPERTY TYPE)
    if(variable MATCHES "^BPR_" AND kind STREQUAL "BOOL")
        list(APPEND bpr_release_option_names "${variable}")
    endif()
endforeach()
list(REMOVE_DUPLICATES bpr_release_option_names)
list(SORT bpr_release_option_names)
foreach(option IN LISTS bpr_release_option_names)
    set(bpr_release_boolean OFF)
    if(${option})
        set(bpr_release_boolean ON)
    endif()
    list(APPEND bpr_release_options "\"${option}\":\"${bpr_release_boolean}\"")
endforeach()
list(JOIN bpr_release_options "," bpr_release_options)
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/_bpr")
set(BPR_RELEASE_OBSERVED "${CMAKE_BINARY_DIR}/_bpr/release-observed.json")
string(TOUPPER "${bpr_release_type}" bpr_release_upper_type)
set(bpr_release_setting_names CMAKE_C_FLAGS CMAKE_CXX_FLAGS CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS
    CMAKE_C_FLAGS_${bpr_release_upper_type} CMAKE_CXX_FLAGS_${bpr_release_upper_type}
    CMAKE_EXE_LINKER_FLAGS_${bpr_release_upper_type} CMAKE_SHARED_LINKER_FLAGS_${bpr_release_upper_type}
    CMAKE_OSX_DEPLOYMENT_TARGET CMAKE_OSX_SYSROOT CMAKE_MSVC_RUNTIME_LIBRARY CMAKE_GENERATOR
    CMAKE_CXX_COMPILER_TARGET CMAKE_INTERPROCEDURAL_OPTIMIZATION CMAKE_POSITION_INDEPENDENT_CODE)
set(bpr_release_settings "")
foreach(setting IN LISTS bpr_release_setting_names)
    set(value "${${setting}}")
    if(setting STREQUAL "CMAKE_OSX_SYSROOT" AND IS_ABSOLUTE "${value}")
        get_filename_component(value "${value}" NAME)
    endif()
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    list(APPEND bpr_release_settings "\"${setting}\":\"${value}\"")
endforeach()
list(JOIN bpr_release_settings "," bpr_release_settings)
file(WRITE "${BPR_RELEASE_OBSERVED}"
    "{\"version\":\"${PROJECT_VERSION}\",\"platform\":\"${CMAKE_SYSTEM_NAME}\",\"architectures\":[\"${bpr_release_architectures}\"],\"buildType\":\"${bpr_release_type}\",\"options\":{${bpr_release_options}},\"settings\":{${bpr_release_settings}},\"toolchain\":{\"cmake\":\"${CMAKE_VERSION}\",\"compilerId\":\"${CMAKE_CXX_COMPILER_ID}\",\"compilerVersion\":\"${CMAKE_CXX_COMPILER_VERSION}\",\"qtVersion\":\"${BPR_PRODUCT_QT_VERSION}\"}}\n")
if(BPR_RELEASE_COHORT)
    if(NOT IS_ABSOLUTE "${BPR_RELEASE_COHORT}" OR NOT BPR_RELEASE_PRODUCER)
        message(FATAL_ERROR "Release producers require an absolute BPR_RELEASE_COHORT and BPR_RELEASE_PRODUCER")
    endif()
    find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/packaging/release_build.py" configure
        --root "${PROJECT_SOURCE_DIR}" --cohort "${BPR_RELEASE_COHORT}" --producer "${BPR_RELEASE_PRODUCER}"
        --observed "${BPR_RELEASE_OBSERVED}" --output "${CMAKE_BINARY_DIR}/_bpr/release-binding.json"
        RESULT_VARIABLE bpr_release_result OUTPUT_VARIABLE bpr_release_binding ERROR_VARIABLE bpr_release_error)
    if(NOT bpr_release_result EQUAL 0)
        message(FATAL_ERROR "Frozen release cohort refused: ${bpr_release_error}")
    endif()
    file(READ "${BPR_RELEASE_COHORT}" BPR_RELEASE_JSON)
    configure_file("${BPR_RELEASE_COHORT}" "${CMAKE_BINARY_DIR}/_bpr/release-cohort.json" COPYONLY)
    string(JSON BPR_RELEASE_BUILD_NUMBER GET "${bpr_release_binding}" number)
    string(JSON BPR_RELEASE_CONFIGURATION_DIGEST GET "${bpr_release_binding}" configurationDigest)
    string(JSON BPR_RELEASE_COHORT_DIGEST GET "${bpr_release_binding}" cohortDigest)
    foreach(mapping IN ITEMS displayVersion assetVersion macBundleVersion msiProductVersion msiProductCode debianVersion)
        string(JSON bpr_release_${mapping} GET "${bpr_release_binding}" native "${mapping}")
    endforeach()
    set(BPR_RELEASE_DISPLAY_VERSION "${bpr_release_displayVersion}")
    set(BPR_RELEASE_ASSET_VERSION "${bpr_release_assetVersion}")
    set(BPR_RELEASE_MAC_VERSION "${bpr_release_macBundleVersion}")
    set(BPR_RELEASE_MSI_VERSION "${bpr_release_msiProductVersion}")
    set(BPR_RELEASE_MSI_PRODUCT_CODE "${bpr_release_msiProductCode}")
    set(BPR_RELEASE_DEBIAN_VERSION "${bpr_release_debianVersion}")
    # Every build checks the candidate again before any first-party compilation.
    add_custom_target(bpr_release_cohort_check
        COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/packaging/release_build.py" configure
            --root "${PROJECT_SOURCE_DIR}" --cohort "${BPR_RELEASE_COHORT}" --producer "${BPR_RELEASE_PRODUCER}"
            --observed "${BPR_RELEASE_OBSERVED}"
        VERBATIM)
endif()
