include_guard(GLOBAL)

# Unknown GUI/application courses remain exclusive. A caller may opt audited
# correctness rows into bounded concurrency only after this default is applied.
function(bpr_schedule_test_directory directory)
    get_property(rows DIRECTORY "${directory}" PROPERTY TESTS)
    foreach(row IN LISTS rows)
        get_property(environment TEST "${row}" DIRECTORY "${directory}" PROPERTY ENVIRONMENT)
        string(TOUPPER "${environment}" normalized_environment)
        if(directory MATCHES "/tests/(adapters_qt|end_to_end)(/|$)"
           OR normalized_environment MATCHES "QT_QPA_PLATFORM=")
            get_property(explicit_serial TEST "${row}" DIRECTORY "${directory}" PROPERTY RUN_SERIAL)
            if(explicit_serial)
                set_property(TEST "${row}" DIRECTORY "${directory}" APPEND PROPERTY LABELS bpr_explicit_serial)
            endif()
            set_tests_properties("${row}" DIRECTORY "${directory}" PROPERTIES RUN_SERIAL TRUE)
            set_property(TEST "${row}" DIRECTORY "${directory}" APPEND PROPERTY LABELS bpr_serial_gui)
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        bpr_schedule_test_directory("${child}")
    endforeach()
endfunction()

# [[BPR-1670]]. This is an explicit source-audited declaration, not an inference
# from a directory or from using Qt. RESOURCE names the actual shared output or
# executable lifetime; existing locks and fixture dependencies remain intact.
function(bpr_allow_isolated_correctness)
    cmake_parse_arguments(PARSE_ARGV 0 schedule "" "DIRECTORY;MODE;RESOURCE" "TESTS;CONFIGURATIONS")
    if(schedule_UNPARSED_ARGUMENTS OR NOT schedule_DIRECTORY OR NOT schedule_TESTS
       OR NOT schedule_RESOURCE MATCHES "^[a-z0-9_]+$"
       OR NOT schedule_MODE MATCHES "^(headless|offscreen)$")
        message(FATAL_ERROR "Isolated correctness requires DIRECTORY, MODE headless/offscreen, RESOURCE and TESTS")
    endif()
    if(NOT schedule_CONFIGURATIONS STREQUAL "Debug")
        message(FATAL_ERROR "Isolated correctness requires audited CONFIGURATIONS Debug")
    endif()
    string(JOIN "," audited_configurations ${schedule_CONFIGURATIONS})
    set(admitted "$<CONFIG:${audited_configurations}>")
    get_property(registered DIRECTORY "${schedule_DIRECTORY}" PROPERTY TESTS)
    foreach(row IN LISTS schedule_TESTS)
        if(NOT row IN_LIST registered)
            message(FATAL_ERROR "Isolated correctness names an unregistered test: ${row}")
        endif()
        get_property(labels TEST "${row}" DIRECTORY "${schedule_DIRECTORY}" PROPERTY LABELS)
        if(NOT bpr_serial_gui IN_LIST labels)
            message(FATAL_ERROR "Isolated correctness requires the default schedule first: ${row}")
        endif()
        if(bpr_explicit_serial IN_LIST labels)
            message(FATAL_ERROR "Isolated correctness cannot override explicit exclusivity: ${row}")
        endif()
        get_property(environment TEST "${row}" DIRECTORY "${schedule_DIRECTORY}" PROPERTY ENVIRONMENT)
        get_property(modifications TEST "${row}" DIRECTORY "${schedule_DIRECTORY}" PROPERTY ENVIRONMENT_MODIFICATION)
        foreach(modification IN LISTS modifications)
            string(TOUPPER "${modification}" normalized_modification)
            if(normalized_modification MATCHES "^QT_QPA_PLATFORM=")
                message(FATAL_ERROR "Isolated correctness cannot override its QPA platform: ${row}")
            endif()
        endforeach()
        # Windows treats environment names case-insensitively. Count aliases
        # too, then require the one canonical declaration without an override.
        set(platforms)
        foreach(variable IN LISTS environment)
            string(TOUPPER "${variable}" normalized_variable)
            if(normalized_variable MATCHES "^QT_QPA_PLATFORM=")
                list(APPEND platforms "${variable}")
            endif()
        endforeach()
        list(LENGTH platforms platform_count)
        if(schedule_MODE STREQUAL "offscreen")
            if(NOT platform_count EQUAL 1 OR NOT platforms STREQUAL "QT_QPA_PLATFORM=offscreen")
                message(FATAL_ERROR "Offscreen correctness requires exactly QT_QPA_PLATFORM=offscreen: ${row}")
            endif()
        elseif(NOT platform_count EQUAL 0)
            message(FATAL_ERROR "Headless correctness must have no QPA platform: ${row}")
        endif()
        get_property(locks TEST "${row}" DIRECTORY "${schedule_DIRECTORY}" PROPERTY RESOURCE_LOCK)
        list(APPEND locks "bpr_isolated_correctness_${schedule_RESOURCE}")
        list(REMOVE_DUPLICATES locks)
        list(REMOVE_ITEM labels bpr_serial_gui)
        list(APPEND labels
            "$<${admitted}:bpr_isolated_correctness>"
            "$<${admitted}:bpr_correctness_${schedule_MODE}>"
            "$<${admitted}:bpr_correctness_config_$<CONFIG>>"
            "$<$<NOT:${admitted}>:bpr_serial_gui>")
        list(REMOVE_DUPLICATES labels)
        set_tests_properties("${row}" DIRECTORY "${schedule_DIRECTORY}" PROPERTIES
            RUN_SERIAL "$<NOT:${admitted}>" RESOURCE_LOCK "${locks}" LABELS "${labels}")
    endforeach()
endfunction()

# [[BPR-1673]]. Apply only a named, source-bound command from the audited registry.
# Drift falls back to the already installed exclusive schedule. Registration or
# schema mistakes fail configure instead of creating an unaudited exception.
function(bpr_apply_command_correctness_registry registry)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${registry}")
    file(READ "${registry}" document)
    string(JSON schema GET "${document}" schema)
    if(NOT schema STREQUAL "bpr.command-correctness.v1")
        message(FATAL_ERROR "Unknown command correctness registry schema")
    endif()
    string(JSON feature_count LENGTH "${document}" features)
    if(feature_count GREATER 0)
        math(EXPR feature_last "${feature_count} - 1")
        foreach(feature_index RANGE ${feature_last})
            string(JSON feature MEMBER "${document}" features ${feature_index})
            string(JSON expected_feature GET "${document}" features "${feature}")
            if(NOT "${${feature}}" STREQUAL "${expected_feature}")
                message(STATUS "Command correctness feature drift; keeping exclusive: ${feature}")
                return()
            endif()
        endforeach()
    endif()
    string(JSON family_count LENGTH "${document}" families)
    math(EXPR family_last "${family_count} - 1")
    foreach(family RANGE ${family_last})
        string(JSON source GET "${document}" families ${family} source)
        string(JSON expected_hash GET "${document}" families ${family} sha256)
        string(JSON directory GET "${document}" families ${family} directory)
        set(directory "${PROJECT_SOURCE_DIR}/${directory}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/${source}")
        file(SHA256 "${PROJECT_SOURCE_DIR}/${source}" actual_hash)
        set(valid_inputs TRUE)
        string(JSON input_count LENGTH "${document}" families ${family} inputs)
        if(input_count GREATER 0)
            math(EXPR input_last "${input_count} - 1")
            foreach(input_index RANGE ${input_last})
                string(JSON input GET "${document}" families ${family} inputs ${input_index} path)
                string(JSON input_expected GET "${document}" families ${family} inputs ${input_index} sha256)
                set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/${input}")
                file(SHA256 "${PROJECT_SOURCE_DIR}/${input}" input_actual)
                if(NOT input_actual STREQUAL input_expected)
                    set(valid_inputs FALSE)
                endif()
            endforeach()
        endif()
        if(NOT valid_inputs OR NOT actual_hash STREQUAL expected_hash)
            message(STATUS "Command correctness audit stale; keeping exclusive: ${source}")
            continue()
        endif()
        get_property(binary_directory DIRECTORY "${directory}" PROPERTY BINARY_DIR)
        get_property(registered DIRECTORY "${directory}" PROPERTY TESTS)
        string(JSON row_count LENGTH "${document}" families ${family} rows)
        math(EXPR row_last "${row_count} - 1")
        foreach(index RANGE ${row_last})
            string(JSON row GET "${document}" families ${family} rows ${index} name)
            string(JSON platforms GET "${document}" families ${family} rows ${index} platforms)
            string(FIND "${platforms}" "\"${CMAKE_SYSTEM_NAME}\"" platform_index)
            if(platform_index EQUAL -1)
                continue()
            endif()
            if(row IN_LIST seen_rows OR NOT row IN_LIST registered)
                message(FATAL_ERROR "Duplicate or unregistered command correctness row: ${row}")
            endif()
            list(APPEND seen_rows "${row}")
            string(JSON policy GET "${document}" families ${family} rows ${index} scheduling)
            if(policy STREQUAL "exclusive")
                continue()
            elseif(NOT policy STREQUAL "correctness")
                message(FATAL_ERROR "Unknown command correctness policy: ${row}")
            endif()
            string(JSON expected_command GET "${document}" families ${family} rows ${index} command)
            string(REPLACE "{binary_dir}" "${binary_directory}" expected_command "${expected_command}")
            get_property(actual_command TEST "${row}" DIRECTORY "${directory}" PROPERTY BPR_LOGICAL_COMMAND)
            if(NOT actual_command STREQUAL expected_command)
                message(STATUS "Command correctness argv drift; keeping exclusive: ${row}")
                continue()
            endif()
            get_property(environment TEST "${row}" DIRECTORY "${directory}" PROPERTY ENVIRONMENT)
            if(NOT environment MATCHES "(^|;)QT_SCALE_FACTOR=")
                set_property(TEST "${row}" DIRECTORY "${directory}" APPEND PROPERTY ENVIRONMENT "QT_SCALE_FACTOR=1.0")
                list(APPEND environment "QT_SCALE_FACTOR=1.0")
            endif()
            set(valid_environment TRUE)
            string(JSON environment_count LENGTH "${document}" families ${family} rows ${index} environment)
            math(EXPR environment_last "${environment_count} - 1")
            foreach(environment_index RANGE ${environment_last})
                string(JSON expected_variable GET "${document}" families ${family} rows ${index} environment ${environment_index})
                string(REPLACE "{binary_dir}" "${binary_directory}" expected_variable "${expected_variable}")
                string(REPLACE "{build_dir}" "${PROJECT_BINARY_DIR}" expected_variable "${expected_variable}")
                if(NOT expected_variable IN_LIST environment)
                    set(valid_environment FALSE)
                endif()
                string(REGEX REPLACE "=.*$" "" expected_name "${expected_variable}")
                string(TOUPPER "${expected_name}" expected_name)
                set(alias_count 0)
                foreach(actual_variable IN LISTS environment)
                    string(REGEX REPLACE "=.*$" "" actual_name "${actual_variable}")
                    string(TOUPPER "${actual_name}" actual_name)
                    if(actual_name STREQUAL expected_name)
                        math(EXPR alias_count "${alias_count} + 1")
                    endif()
                endforeach()
                if(NOT alias_count EQUAL 1)
                    set(valid_environment FALSE)
                endif()
                get_property(modifications TEST "${row}" DIRECTORY "${directory}" PROPERTY ENVIRONMENT_MODIFICATION)
                foreach(modification IN LISTS modifications)
                    string(REGEX REPLACE "=.*$" "" modified_name "${modification}")
                    string(TOUPPER "${modified_name}" modified_name)
                    if(modified_name STREQUAL expected_name)
                        set(valid_environment FALSE)
                    endif()
                endforeach()
            endforeach()
            if(NOT valid_environment)
                message(STATUS "Command correctness environment drift; keeping exclusive: ${row}")
                continue()
            endif()
            # Optional human-render roots must not enter a qualification command
            # from its parent shell. Declared row outputs retain their exact paths.
            string(JSON unset_count LENGTH "${document}" families ${family} unset_environment)
            math(EXPR unset_last "${unset_count} - 1")
            if(unset_count GREATER 0)
                foreach(variable_index RANGE ${unset_last})
                    string(JSON variable GET "${document}" families ${family} unset_environment ${variable_index})
                    set_property(TEST "${row}" DIRECTORY "${directory}" APPEND PROPERTY
                        ENVIRONMENT_MODIFICATION "${variable}=unset:")
                endforeach()
            endif()
            get_property(environment TEST "${row}" DIRECTORY "${directory}" PROPERTY ENVIRONMENT)
            if(source MATCHES "workbench_window_tests.cpp$")
                if(NOT environment MATCHES "(^|;)BPR_QT_RENDER_PATH=")
                    set_property(TEST "${row}" DIRECTORY "${directory}" APPEND PROPERTY
                        ENVIRONMENT_MODIFICATION "BPR_QT_RENDER_PATH=unset:")
                endif()
            endif()
            string(JSON resource GET "${document}" families ${family} rows ${index} resource)
            bpr_allow_isolated_correctness(DIRECTORY "${directory}" MODE offscreen
                RESOURCE "${resource}" CONFIGURATIONS Debug TESTS "${row}")
            set_property(TEST "${row}" DIRECTORY "${directory}" APPEND PROPERTY LABELS
                "$<$<CONFIG:Debug>:bpr_command_owned>")
        endforeach()
    endforeach()
endfunction()
