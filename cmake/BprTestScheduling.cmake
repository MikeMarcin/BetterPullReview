include_guard(GLOBAL)

# Unknown GUI/application courses remain exclusive. A caller may opt audited
# correctness rows into bounded concurrency only after this default is applied.
function(bpr_schedule_test_directory directory)
    get_property(rows DIRECTORY "${directory}" PROPERTY TESTS)
    foreach(row IN LISTS rows)
        get_property(environment TEST "${row}" DIRECTORY "${directory}" PROPERTY ENVIRONMENT)
        string(TOUPPER "${environment}" normalized_environment)
        if(directory MATCHES "/tests/(adapters_qt|end_to_end)(/|$)"
           OR normalized_environment MATCHES "QT_QPA_PLATFORM=")
            get_property(explicit_serial TEST "${row}" DIRECTORY "${directory}" PROPERTY RUN_SERIAL)
            if(explicit_serial)
                set_property(TEST "${row}" DIRECTORY "${directory}" APPEND PROPERTY LABELS bpr_explicit_serial)
            endif()
            set_tests_properties("${row}" DIRECTORY "${directory}" PROPERTIES RUN_SERIAL TRUE)
            set_property(TEST "${row}" DIRECTORY "${directory}" APPEND PROPERTY LABELS bpr_serial_gui)
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        bpr_schedule_test_directory("${child}")
    endforeach()
endfunction()

# [[BPR-1670]]. This is an explicit source-audited declaration, not an inference
# from a directory or from using Qt. RESOURCE names the actual shared output or
# executable lifetime; existing locks and fixture dependencies remain intact.
function(bpr_allow_isolated_correctness)
    cmake_parse_arguments(PARSE_ARGV 0 schedule "" "DIRECTORY;MODE;RESOURCE" "TESTS")
    if(schedule_UNPARSED_ARGUMENTS OR NOT schedule_DIRECTORY OR NOT schedule_TESTS
       OR NOT schedule_RESOURCE MATCHES "^[a-z0-9_]+$"
       OR NOT schedule_MODE MATCHES "^(headless|offscreen)$")
        message(FATAL_ERROR "Isolated correctness requires DIRECTORY, MODE headless/offscreen, RESOURCE and TESTS")
    endif()
    get_property(registered DIRECTORY "${schedule_DIRECTORY}" PROPERTY TESTS)
    foreach(row IN LISTS schedule_TESTS)
        if(NOT row IN_LIST registered)
            message(FATAL_ERROR "Isolated correctness names an unregistered test: ${row}")
        endif()
        get_property(labels TEST "${row}" DIRECTORY "${schedule_DIRECTORY}" PROPERTY LABELS)
        if(NOT bpr_serial_gui IN_LIST labels)
            message(FATAL_ERROR "Isolated correctness requires the default schedule first: ${row}")
        endif()
        if(bpr_explicit_serial IN_LIST labels)
            message(FATAL_ERROR "Isolated correctness cannot override explicit exclusivity: ${row}")
        endif()
        get_property(environment TEST "${row}" DIRECTORY "${schedule_DIRECTORY}" PROPERTY ENVIRONMENT)
        get_property(modifications TEST "${row}" DIRECTORY "${schedule_DIRECTORY}" PROPERTY ENVIRONMENT_MODIFICATION)
        foreach(modification IN LISTS modifications)
            string(TOUPPER "${modification}" normalized_modification)
            if(normalized_modification MATCHES "^QT_QPA_PLATFORM=")
                message(FATAL_ERROR "Isolated correctness cannot override its QPA platform: ${row}")
            endif()
        endforeach()
        # Windows treats environment names case-insensitively. Count aliases
        # too, then require the one canonical declaration without an override.
        set(platforms)
        foreach(variable IN LISTS environment)
            string(TOUPPER "${variable}" normalized_variable)
            if(normalized_variable MATCHES "^QT_QPA_PLATFORM=")
                list(APPEND platforms "${variable}")
            endif()
        endforeach()
        list(LENGTH platforms platform_count)
        if(schedule_MODE STREQUAL "offscreen")
            if(NOT platform_count EQUAL 1 OR NOT platforms STREQUAL "QT_QPA_PLATFORM=offscreen")
                message(FATAL_ERROR "Offscreen correctness requires exactly QT_QPA_PLATFORM=offscreen: ${row}")
            endif()
        elseif(NOT platform_count EQUAL 0)
            message(FATAL_ERROR "Headless correctness must have no QPA platform: ${row}")
        endif()
        get_property(locks TEST "${row}" DIRECTORY "${schedule_DIRECTORY}" PROPERTY RESOURCE_LOCK)
        list(APPEND locks "bpr_isolated_correctness_${schedule_RESOURCE}")
        list(REMOVE_DUPLICATES locks)
        list(REMOVE_ITEM labels bpr_serial_gui)
        list(APPEND labels bpr_isolated_correctness "bpr_correctness_${schedule_MODE}")
        list(REMOVE_DUPLICATES labels)
        set_tests_properties("${row}" DIRECTORY "${schedule_DIRECTORY}" PROPERTIES
            RUN_SERIAL FALSE RESOURCE_LOCK "${locks}" LABELS "${labels}")
    endforeach()
endfunction()
