include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/AitoCpm.cmake")
function(bpr_acquire_glaze)
    if(TARGET glaze::glaze OR TARGET better_pull_review_glaze)
        message(FATAL_ERROR "Glaze target must be owned by the pinned provider")
    endif()
    if(DEFINED FETCHCONTENT_SOURCE_DIR_BPRGLAZE AND NOT FETCHCONTENT_SOURCE_DIR_BPRGLAZE STREQUAL "")
        message(FATAL_ERROR "Glaze source substitution is forbidden")
    endif()
    bpr_load_cpm()
    set(archive "${CPM_SOURCE_CACHE}/glaze-v8.3.0.tar.gz")
    set(digest "6a8f97f5cdb8df5c87f1b32710679585f3f1a577b67bb66150f2516072e00317")
    file(LOCK "${archive}.lock" GUARD FUNCTION TIMEOUT 120)
    if(NOT EXISTS "${archive}")
        if(BPR_DEPENDENCY_OFFLINE)
            message(FATAL_ERROR "Offline mode requires cached Glaze v8.3.0 archive")
        endif()
        file(DOWNLOAD "https://codeload.github.com/stephenberry/glaze/tar.gz/refs/tags/v8.3.0"
             "${archive}" EXPECTED_HASH "SHA256=${digest}" TLS_VERIFY ON)
    endif()
    file(SHA256 "${archive}" actual)
    file(SIZE "${archive}" bytes)
    if(NOT actual STREQUAL digest OR NOT bytes EQUAL 2147798)
        message(FATAL_ERROR "Glaze archive does not match pinned v8.3.0")
    endif()
    # Re-extract the verified archive: never trust an editable cached source tree.
    set(stage "${CMAKE_BINARY_DIR}/_bpr/glaze")
    file(REMOVE_RECURSE "${stage}")
    file(MAKE_DIRECTORY "${stage}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${stage}")
    set(license "${stage}/glaze-8.3.0/LICENSE")
    file(SHA256 "${license}" license_digest)
    if(NOT license_digest STREQUAL "5d49e66411a0807a7c8d6b911b9a26b59e940c71aebe561a3ad8b0b80ac4b7b6")
        message(FATAL_ERROR "Glaze license does not match the pinned MIT notice")
    endif()
    # Glaze is header-only. Do not execute upstream CMake, tests, examples or install rules.
    add_library(better_pull_review_glaze INTERFACE)
    add_library(glaze::glaze ALIAS better_pull_review_glaze)
    target_include_directories(better_pull_review_glaze SYSTEM INTERFACE "${stage}/glaze-8.3.0/include")
    target_compile_features(better_pull_review_glaze INTERFACE cxx_std_23)
endfunction()
