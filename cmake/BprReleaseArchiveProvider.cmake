include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/AitoCpm.cmake")

# macOS staging uses this parser, never an external extraction command. ZIP is
# the only reader enabled by the adapter; optional codecs and tools stay off.
function(bpr_configure_release_archive)
    bpr_load_cpm()
    if(DEFINED FETCHCONTENT_SOURCE_DIR_BPRLIBARCHIVE OR CPM_BprLibArchive_SOURCE)
        message(FATAL_ERROR "Release staging requires the pinned LibArchive provider")
    endif()
    set(archive_arguments
        NAME BprLibArchive VERSION 3.8.9 DOWNLOAD_ONLY YES FORCE YES)
    if(BPR_DEPENDENCY_OFFLINE)
        file(GLOB candidates "${CPM_SOURCE_CACHE}/bprlibarchive/*/libarchive/archive.h")
        set(cached "")
        foreach(header IN LISTS candidates)
            file(STRINGS "${header}" version REGEX "^#define[ \t]+ARCHIVE_VERSION_NUMBER[ \t]+3008009$")
            if(version)
                get_filename_component(cached "${header}/../.." ABSOLUTE)
                break()
            endif()
        endforeach()
        if(NOT cached)
            message(FATAL_ERROR "Offline release staging requires cached LibArchive 3.8.9")
        endif()
        list(APPEND archive_arguments SOURCE_DIR "${cached}")
    else()
        list(APPEND archive_arguments
            URL "https://libarchive.org/downloads/libarchive-3.8.9.tar.xz"
            URL_HASH "SHA256=888c934f9d95648ecb9163dc8e23ab80a476ecb81a8f1154704a227b5b676dde")
    endif()
    CPMAddPackage(${archive_arguments})
    foreach(feature IN ITEMS TEST INSTALL TAR CPIO CAT UNZIP OPENSSL MBEDTLS NETTLE LIBB2 LZMA BZip2 LZ4 ZSTD LIBXML2 EXPAT PCREPOSIX PCRE2POSIX ACL XATTR)
        set(ENABLE_${feature} OFF)
    endforeach()
    set(BUILD_SHARED_LIBS OFF)
    set(ENABLE_ZLIB ON)
    add_subdirectory("${BprLibArchive_SOURCE_DIR}" "${CMAKE_BINARY_DIR}/_bpr/libarchive" EXCLUDE_FROM_ALL)
    add_library(BetterPullReview::ReleaseArchive ALIAS archive_static)
    target_include_directories(archive_static SYSTEM INTERFACE "${BprLibArchive_SOURCE_DIR}/libarchive")

    # Keep upstream notices (including every individual source's controlling
    # header) with the macOS bundle, without vendoring third-party source.
    file(READ "${BprLibArchive_SOURCE_DIR}/COPYING" notices)
    file(GLOB license_sources "${BprLibArchive_SOURCE_DIR}/libarchive/*.c" "${BprLibArchive_SOURCE_DIR}/libarchive/*.h")
    list(SORT license_sources)
    foreach(source IN LISTS license_sources)
        file(READ "${source}" contents LIMIT 32768)
        string(FIND "${contents}" "*/" header_end)
        if(header_end GREATER_EQUAL 0)
            math(EXPR header_end "${header_end}+2")
            string(SUBSTRING "${contents}" 0 ${header_end} header)
            get_filename_component(name "${source}" NAME)
            string(APPEND notices "\n\n${name}\n${header}\n")
        endif()
    endforeach()
    file(WRITE "${CMAKE_BINARY_DIR}/_bpr/LibArchive-NOTICES.txt" "${notices}")
endfunction()
