# [[BPR-0974]]. Script mode: names the SHA-256 of the Qt resource bundle in a
# header, so the image that ships the bundle refuses any other bytes.
#   cmake -DBPR_BUNDLE=<bundle> -DBPR_HEADER=<header> -P BprQtResourceBundleDigest.cmake
if(NOT DEFINED BPR_BUNDLE OR NOT DEFINED BPR_HEADER)
    message(FATAL_ERROR "BPR_BUNDLE and BPR_HEADER are required")
endif()
if(NOT EXISTS "${BPR_BUNDLE}")
    message(FATAL_ERROR "The Qt resource bundle ${BPR_BUNDLE} was not built")
endif()
file(SHA256 "${BPR_BUNDLE}" digest)
file(
    WRITE
    "${BPR_HEADER}"
    "// Generated by cmake/BprQtResourceBundleDigest.cmake. Do not edit.\n"
    "#ifndef BPR_QT_RESOURCE_BUNDLE_SHA256\n"
    "#define BPR_QT_RESOURCE_BUNDLE_SHA256 \"${digest}\"\n"
    "#endif\n"
)
