include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/AitoCpm.cmake")

# [[BPR-1439]]. {fmt} for text formatting, one of the owner-approved core
# libraries (2026-10-13); the owner chose it over `std::format`. It is used
# header-only (FMT_HEADER_ONLY): no upstream build, tests or install rules
# run, and no `os.cc` file I/O is compiled. Quill's bundled copy lives in its
# own `fmtquill` namespace and is a separate component.
function(bpr_acquire_fmt)
    if(TARGET BetterPullReview::Fmt OR TARGET better_pull_review_fmt)
        message(FATAL_ERROR "fmt target must be owned by the pinned provider")
    endif()
    if(DEFINED FETCHCONTENT_SOURCE_DIR_BPRFMT)
        if(NOT "${FETCHCONTENT_SOURCE_DIR_BPRFMT}" STREQUAL "")
            message(FATAL_ERROR "fmt source substitution is forbidden")
        endif()
    endif()
    bpr_load_cpm()
    set(archive "${CPM_SOURCE_CACHE}/fmt-12.2.0.zip")
    set(digest "a2f4a8d51178f954e4c339007f77edd76ba0cb2e36f87a48e5a5403d9be5878f")
    file(LOCK "${archive}.lock" GUARD FUNCTION TIMEOUT 120)
    if(NOT EXISTS "${archive}")
        if(BPR_DEPENDENCY_OFFLINE)
            message(FATAL_ERROR "Offline mode requires cached fmt 12.2.0 archive")
        endif()
        file(DOWNLOAD "https://github.com/fmtlib/fmt/releases/download/12.2.0/fmt-12.2.0.zip"
             "${archive}" EXPECTED_HASH "SHA256=${digest}" TLS_VERIFY ON)
    endif()
    file(SHA256 "${archive}" actual)
    file(SIZE "${archive}" bytes)
    if(NOT actual STREQUAL digest OR NOT bytes EQUAL 1486029)
        message(FATAL_ERROR "fmt archive does not match pinned 12.2.0")
    endif()
    # Re-extract the verified archive: never trust an editable cached source tree.
    set(stage "${CMAKE_BINARY_DIR}/_bpr/fmt")
    file(REMOVE_RECURSE "${stage}")
    file(MAKE_DIRECTORY "${stage}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${stage}")
    set(source "${stage}/fmt-12.2.0")
    file(SHA256 "${source}/LICENSE" license_digest)
    if(NOT license_digest STREQUAL "a65fcc5a1095fc33cc37e4fff69366e49d7e92f613558a2b95ed1b70e33758b4")
        message(FATAL_ERROR "fmt license does not match the pinned notice")
    endif()
    add_library(better_pull_review_fmt INTERFACE)
    add_library(BetterPullReview::Fmt ALIAS better_pull_review_fmt)
    target_include_directories(better_pull_review_fmt SYSTEM INTERFACE "${source}/include")
    target_compile_definitions(better_pull_review_fmt INTERFACE FMT_HEADER_ONLY)
    target_compile_features(better_pull_review_fmt INTERFACE cxx_std_23)
endfunction()
