# [[BPR-1720]]. The commit a build was made from, for Help › About.
#
# Included, this file defines bpr_add_build_identity(). Run as a script, it
# writes the header that function names. Every build runs the script, which
# asks Git for three facts about the source tree and rewrites the header only
# when one changed, so an unchanged commit recompiles nothing:
#
#   BPR_BUILD_COMMIT         the full HEAD commit, or "" outside a checkout
#   BPR_BUILD_COMMIT_DATE    that commit's committer date, "YYYY-MM-DD"
#   BPR_BUILD_LOCAL_CHANGES  1 when tracked files differ from the commit
#
# The commit's date rather than the clock's, so two builds of one commit say
# the same thing. A tree that is not its own Git checkout (an exported
# attended-review root, a source archive) records no commit rather than an
# enclosing repository's. Git runs with --no-optional-locks, so the query never
# takes the index lock another build or agent may hold.

if(CMAKE_SCRIPT_MODE_FILE)
    set(bpr_commit "")
    set(bpr_commit_date "")
    set(bpr_local_changes 0)
    if(BPR_GIT AND IS_DIRECTORY "${BPR_SOURCE_DIR}")
        execute_process(
            COMMAND "${BPR_GIT}" --no-optional-locks -C "${BPR_SOURCE_DIR}" rev-parse --show-toplevel
            OUTPUT_VARIABLE bpr_toplevel
            RESULT_VARIABLE bpr_result
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET
        )
        file(REAL_PATH "${BPR_SOURCE_DIR}" bpr_source_real)
        if(bpr_result EQUAL 0 AND NOT bpr_toplevel STREQUAL "")
            file(REAL_PATH "${bpr_toplevel}" bpr_toplevel_real)
        else()
            set(bpr_toplevel_real "")
        endif()
        if(bpr_toplevel_real STREQUAL bpr_source_real)
            execute_process(
                COMMAND "${BPR_GIT}" --no-optional-locks -C "${BPR_SOURCE_DIR}" log -1 --format=%H%n%cs HEAD
                OUTPUT_VARIABLE bpr_head
                RESULT_VARIABLE bpr_result
                OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET
            )
            if(bpr_result EQUAL 0 AND bpr_head MATCHES "^([0-9a-f]+)\n([0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9])$")
                set(bpr_commit "${CMAKE_MATCH_1}")
                set(bpr_commit_date "${CMAKE_MATCH_2}")
                execute_process(
                    COMMAND "${BPR_GIT}" --no-optional-locks -C "${BPR_SOURCE_DIR}" status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE bpr_status
                    RESULT_VARIABLE bpr_result
                    OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_QUIET
                )
                if(NOT bpr_result EQUAL 0 OR NOT bpr_status STREQUAL "")
                    set(bpr_local_changes 1)
                endif()
            endif()
        endif()
    endif()
    if(NOT BPR_RELEASE_BUILD_NUMBER)
        set(BPR_RELEASE_BUILD_NUMBER 0)
    endif()
    file(WRITE "${BPR_OUTPUT}.next"
        "// Generated by cmake/BprBuildIdentity.cmake on every build. Not tracked.\n"
        "#pragma once\n"
        "#define BPR_BUILD_COMMIT \"${bpr_commit}\"\n"
        "#define BPR_BUILD_COMMIT_DATE \"${bpr_commit_date}\"\n"
        "#define BPR_BUILD_LOCAL_CHANGES ${bpr_local_changes}\n"
        "#define BPR_RELEASE_BUILD_NUMBER ${BPR_RELEASE_BUILD_NUMBER}\n"
        "#define BPR_RELEASE_CONFIGURATION_DIGEST \"${BPR_RELEASE_CONFIGURATION_DIGEST}\"\n"
        "#define BPR_RELEASE_COHORT_DIGEST \"${BPR_RELEASE_COHORT_DIGEST}\"\n"
    )
    file(COPY_FILE "${BPR_OUTPUT}.next" "${BPR_OUTPUT}" ONLY_IF_DIFFERENT)
    file(REMOVE "${BPR_OUTPUT}.next")
    return()
endif()

# bpr_add_build_identity(<target>)
#
# Gives <target> a private include directory holding bpr_build_identity.hpp,
# brought up to date before <target> compiles on every build.
function(bpr_add_build_identity target)
    find_package(Git QUIET)
    set(directory "${CMAKE_CURRENT_BINARY_DIR}/${target}_build_identity")
    set(output "${directory}/bpr_build_identity.hpp")
    file(MAKE_DIRECTORY "${directory}")
    add_custom_target(
        ${target}_build_identity
        COMMAND
            "${CMAKE_COMMAND}"
            "-DBPR_SOURCE_DIR=${PROJECT_SOURCE_DIR}"
            "-DBPR_OUTPUT=${output}"
            "-DBPR_GIT=${GIT_EXECUTABLE}"
            "-DBPR_RELEASE_BUILD_NUMBER=${BPR_RELEASE_BUILD_NUMBER}"
            "-DBPR_RELEASE_CONFIGURATION_DIGEST=${BPR_RELEASE_CONFIGURATION_DIGEST}"
            "-DBPR_RELEASE_COHORT_DIGEST=${BPR_RELEASE_COHORT_DIGEST}"
            -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
        BYPRODUCTS "${output}"
        VERBATIM
    )
    if(TARGET bpr_release_cohort_check)
        add_dependencies(${target}_build_identity bpr_release_cohort_check)
    endif()
    add_dependencies(${target} ${target}_build_identity)
    target_include_directories(${target} PRIVATE "${directory}")
endfunction()
