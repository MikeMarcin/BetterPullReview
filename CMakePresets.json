{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "BPR_BUILD_QT": "ON",
        "BPR_BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "core-only",
      "displayName": "Qt-free core build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core-only",
      "cacheVariables": {
        "BPR_BUILD_QT": "OFF",
        "BPR_BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "core-only",
      "configurePreset": "core-only"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "core-only",
      "configurePreset": "core-only",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
