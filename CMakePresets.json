{
  "$schema": "https://raw.githubusercontent.com/Kitware/CMake/v4.4.2/Help/manual/presets/schema.json",
  "version": 12,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 2
  },
  "configurePresets": [
    {
      "name": "_common",
      "hidden": true,
      "cacheVariables": {
        "BPR_DEPENDENCY_OFFLINE": "OFF",
        "BUILD_TESTING": "ON",
        "CMAKE_TEST_BUILD_DEPENDS": "ON",
        "CPM_SOURCE_CACHE": "${sourceDir}/build/.cpm-cache"
      },
      "warnings": {
        "author": true,
        "deprecated": true,
        "experimental": true,
        "installAbsoluteDestination": true,
        "policy": true,
        "uninitialized": true,
        "unusedCli": true,
        "systemVars": false
      },
      "errors": {
        "author": true,
        "deprecated": true,
        "policy": true
      }
    },
    {
      "name": "_ninja-common",
      "hidden": true,
      "inherits": "_common",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Developer build",
      "inherits": "_ninja-common",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "BPR_BUILD_QT": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "qualification-release",
      "displayName": "Optimized tests-enabled qualification",
      "description": "Release expectations and optimized workload/budget branches. Additional qualification until the Debug residual and native full result are accepted; distinct from distribution.",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/qualification-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "tour-cli",
      "displayName": "Non-GUI tour terminal (tests disabled)",
      "inherits": "_ninja-common",
      "binaryDir": "${sourceDir}/build/tour-cli",
      "cacheVariables": {
        "BPR_BUILD_QT": "OFF",
        "BPR_BUILD_TOUR_CLI": "ON",
        "BPR_BUILD_AGENT_INTEGRATIONS": "OFF",
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TEST_BUILD_DEPENDS": "OFF"
      }
    },
    {
      "name": "core-only",
      "displayName": "Qt-free core build",
      "inherits": "_ninja-common",
      "binaryDir": "${sourceDir}/build/core-only",
      "cacheVariables": {
        "BPR_BUILD_QT": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "app-release",
      "displayName": "Release application (tests disabled)",
      "description": "Tests-disabled development graph. Distribution uses macos-release, windows-app-release or linux-package and their restricted installed runtime.",
      "inherits": "_ninja-common",
      "binaryDir": "${sourceDir}/build/app-release",
      "cacheVariables": {
        "BPR_BUILD_QT": "ON",
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TEST_BUILD_DEPENDS": "OFF"
      }
    },
    {
      "name": "macos-release",
      "displayName": "Universal macOS release application",
      "description": "Tests-disabled universal application used by the local signing, notarization, and packaging workflow.",
      "inherits": "_ninja-common",
      "binaryDir": "${sourceDir}/build/macos-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "BPR_BUILD_QT": "ON",
        "BPR_MACOS_CODESIGN_IDENTITY": "-",
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.4",
        "BPR_DISTRIBUTION_BUILD": "ON",
        "CMAKE_TEST_BUILD_DEPENDS": "OFF"
      }
    },
    {
      "name": "macos-release-agent-free",
      "displayName": "Universal macOS release application without agent integrations",
      "description": "[[BPR-1179]]. macos-release without agent integrations; see docs/development/release-packages.md.",
      "inherits": "macos-release",
      "binaryDir": "${sourceDir}/build/macos-release-agent-free",
      "cacheVariables": {
        "BPR_BUILD_AGENT_INTEGRATIONS": "OFF"
      }
    },
    {
      "name": "macos-release-agent-free-automation-off",
      "displayName": "Universal macOS release application without agent integrations or local automation",
      "description": "[[BPR-1179]]. macos-release without agent integrations or local automation; see docs/development/release-packages.md.",
      "inherits": "macos-release",
      "binaryDir": "${sourceDir}/build/macos-release-agent-free-automation-off",
      "cacheVariables": {
        "BPR_BUILD_AGENT_INTEGRATIONS": "OFF",
        "BPR_BUILD_LOCAL_AUTOMATION": "OFF"
      }
    },
    {
      "name": "windows-dev",
      "displayName": "Windows developer build",
      "inherits": "_common",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-dev",
      "description": "Multi-config Visual Studio graph. CMAKE_CONFIGURATION_TYPES names only the configurations the tree selects; the syntax provider builds its dependency once per entry, and Visual Studio's four-entry default made it build MinSizeRel, which does not compile and which nothing consumes (BPR-0495).",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "BPR_BUILD_QT": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "windows-app-release",
      "displayName": "Windows Release application (tests disabled)",
      "description": "app-release on Windows: Ninja single-config, so the shipped artifact lands at src/app without a per-configuration directory (BPR-0311).",
      "inherits": "_ninja-common",
      "binaryDir": "${sourceDir}/build/windows-app-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "BPR_BUILD_QT": "ON",
        "BPR_DISTRIBUTION_BUILD": "ON",
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TEST_BUILD_DEPENDS": "OFF"
      }
    },
    {
      "name": "windows-app-release-agent-free",
      "displayName": "Windows Release application without agent integrations",
      "description": "[[BPR-1179]]. windows-app-release without agent integrations; see docs/development/release-packages.md.",
      "inherits": "windows-app-release",
      "binaryDir": "${sourceDir}/build/windows-app-release-agent-free",
      "cacheVariables": {
        "BPR_BUILD_AGENT_INTEGRATIONS": "OFF"
      }
    },
    {
      "name": "windows-app-release-agent-free-automation-off",
      "displayName": "Windows Release application without agent integrations or local automation",
      "description": "[[BPR-1179]]. windows-app-release without agent integrations or local automation; see docs/development/release-packages.md.",
      "inherits": "windows-app-release",
      "binaryDir": "${sourceDir}/build/windows-app-release-agent-free-automation-off",
      "cacheVariables": {
        "BPR_BUILD_AGENT_INTEGRATIONS": "OFF",
        "BPR_BUILD_LOCAL_AUTOMATION": "OFF"
      }
    },
    {
      "name": "linux-package",
      "displayName": "Linux baseline tests-disabled package",
      "inherits": "app-release",
      "binaryDir": "${sourceDir}/build/linux-package",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "BPR_DISTRIBUTION_BUILD": "ON",
        "CMAKE_INSTALL_PREFIX": "/usr"
      }
    },
    {
      "name": "linux-package-agent-free",
      "displayName": "Linux baseline package without agent integrations",
      "description": "[[BPR-1179]]. linux-package without agent integrations; see docs/development/release-packages.md.",
      "inherits": "linux-package",
      "binaryDir": "${sourceDir}/build/linux-package-agent-free",
      "cacheVariables": {
        "BPR_BUILD_AGENT_INTEGRATIONS": "OFF"
      }
    },
    {
      "name": "linux-package-agent-free-automation-off",
      "displayName": "Linux baseline package without agent integrations or local automation",
      "description": "[[BPR-1179]]. linux-package without agent integrations or local automation; see docs/development/release-packages.md.",
      "inherits": "linux-package",
      "binaryDir": "${sourceDir}/build/linux-package-agent-free-automation-off",
      "cacheVariables": {
        "BPR_BUILD_AGENT_INTEGRATIONS": "OFF",
        "BPR_BUILD_LOCAL_AUTOMATION": "OFF"
      }
    },
    {
      "name": "windows-qualification-release",
      "displayName": "Windows optimized tests-enabled qualification",
      "inherits": "windows-dev"
    }
  ],
  "buildPresets": [
    {
      "name": "tour-cli",
      "inherits": "_build-common",
      "configurePreset": "tour-cli",
      "targets": [
        "app_bpr"
      ]
    },
    {
      "name": "_build-common",
      "hidden": true
    },
    {
      "name": "dev",
      "inherits": "_build-common",
      "configurePreset": "dev"
    },
    {
      "name": "core-only",
      "inherits": "_build-common",
      "configurePreset": "core-only"
    },
    {
      "name": "app-release",
      "inherits": "_build-common",
      "configurePreset": "app-release",
      "targets": [
        "app_better_pull_review"
      ]
    },
    {
      "name": "macos-release",
      "inherits": "_build-common",
      "configurePreset": "macos-release",
      "targets": [
        "app_better_pull_review"
      ]
    },
    {
      "name": "macos-release-agent-free",
      "inherits": "_build-common",
      "configurePreset": "macos-release-agent-free",
      "targets": [
        "app_better_pull_review"
      ]
    },
    {
      "name": "macos-release-agent-free-automation-off",
      "inherits": "_build-common",
      "configurePreset": "macos-release-agent-free-automation-off",
      "targets": [
        "app_better_pull_review"
      ]
    },
    {
      "name": "windows-dev",
      "inherits": "_build-common",
      "configurePreset": "windows-dev",
      "configuration": "Debug"
    },
    {
      "name": "windows-app-release",
      "inherits": "_build-common",
      "configurePreset": "windows-app-release",
      "targets": [
        "app_better_pull_review"
      ]
    },
    {
      "name": "windows-app-release-agent-free",
      "inherits": "_build-common",
      "configurePreset": "windows-app-release-agent-free",
      "targets": [
        "app_better_pull_review"
      ]
    },
    {
      "name": "windows-app-release-agent-free-automation-off",
      "inherits": "_build-common",
      "configurePreset": "windows-app-release-agent-free-automation-off",
      "targets": [
        "app_better_pull_review"
      ]
    },
    {
      "name": "qualification-release",
      "inherits": "_build-common",
      "configurePreset": "qualification-release"
    },
    {
      "name": "windows-qualification-release",
      "inherits": "_build-common",
      "configurePreset": "windows-qualification-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "_test-common",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev",
      "inherits": "_test-common",
      "configurePreset": "dev"
    },
    {
      "name": "core-only",
      "inherits": "_test-common",
      "configurePreset": "core-only"
    },
    {
      "name": "windows-dev",
      "inherits": "_test-common",
      "configurePreset": "windows-dev",
      "configuration": "Debug"
    },
    {
      "name": "qualification-release",
      "inherits": "_test-common",
      "configurePreset": "qualification-release"
    },
    {
      "name": "windows-qualification-release",
      "inherits": "_test-common",
      "configurePreset": "windows-qualification-release",
      "configuration": "Release"
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "displayName": "Configure, build, and test developer graph",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "dev"
        },
        {
          "type": "test",
          "name": "dev"
        }
      ]
    },
    {
      "name": "core-only",
      "displayName": "Configure, build, and test Qt-free graph",
      "steps": [
        {
          "type": "configure",
          "name": "core-only"
        },
        {
          "type": "build",
          "name": "core-only"
        },
        {
          "type": "test",
          "name": "core-only"
        }
      ]
    },
    {
      "name": "app-release",
      "displayName": "Configure and build the tests-disabled Release app",
      "steps": [
        {
          "type": "configure",
          "name": "app-release"
        },
        {
          "type": "build",
          "name": "app-release"
        }
      ]
    },
    {
      "name": "macos-release",
      "displayName": "Configure and build the universal tests-disabled macOS app",
      "steps": [
        {
          "type": "configure",
          "name": "macos-release"
        },
        {
          "type": "build",
          "name": "macos-release"
        }
      ]
    },
    {
      "name": "windows-dev",
      "displayName": "Configure, build, and test Windows developer graph",
      "steps": [
        {
          "type": "configure",
          "name": "windows-dev"
        },
        {
          "type": "build",
          "name": "windows-dev"
        },
        {
          "type": "test",
          "name": "windows-dev"
        }
      ]
    }
  ]
}
