{"schema": "implement-rfc.milestone-checkpoint.v1", "run_id": "smooth-panning-20261012", "segment_id": "resumed-skill-resolved", "mandate_revision": "b9a019b63aee9ddcf27e3381564b95f0aa78cef4173b57ce880d216d075eee4d", "selection": {"schema": "implement-rfc.strategy-selection.v1", "strategy": "coordinator-implementer", "topology_id": "coordinator-implementer", "recipe_revision": "2", "recipe_fingerprint": "sha256:b236a31fbebd1a5d2cca1db05ac16f48fcd011dbc312f2d64c00f72dffbe2b14", "routing": {}, "requirement_profile": "coordinator-implementer", "owners": {"engineering": "implementer", "bookkeeping": "implementer", "product_edits": "implementer"}, "delegation": "recipe", "instruction_paths": ["references/engineering-contract.md", "references/strategies/coordinator-implementer.md"], "configuration_complete": true, "missing_routes": [], "host_load": "not_verified"}, "target": "RFC-BPR-0073", "binding": {"plan_id": "smooth-diff-touchpad-panning", "plan_path": "docs/rfcs/plans/smooth-diff-touchpad-panning/milestone-plan.json", "milestone_id": "smooth-comparison-panning", "definition_fingerprint": "sha256:d2465b5fb9873f6dfc5d4d4891457d6155bb787e5c8bedc62812aa1b6f22f0bf", "obligations": [{"id": "BPR-1413:*", "source": "BPR-1413", "selector": null, "source_fingerprint": "sha256:08108275eb959dcec97ee6c9d8f4eaa89cb91f66d56d75203b6f8a342ef137b6"}, {"id": "RFC-BPR-0073:AC01", "source": "RFC-BPR-0073", "selector": "AC01", "source_fingerprint": "sha256:053820a0b7e6fad809e4ede239f5fa1f155bce917f4d0194b412794e7cd14994"}, {"id": "RFC-BPR-0073:AC02", "source": "RFC-BPR-0073", "selector": "AC02", "source_fingerprint": "sha256:053820a0b7e6fad809e4ede239f5fa1f155bce917f4d0194b412794e7cd14994"}, {"id": "RFC-BPR-0073:AC03", "source": "RFC-BPR-0073", "selector": "AC03", "source_fingerprint": "sha256:053820a0b7e6fad809e4ede239f5fa1f155bce917f4d0194b412794e7cd14994"}, {"id": "RFC-BPR-0073:AC04", "source": "RFC-BPR-0073", "selector": "AC04", "source_fingerprint": "sha256:053820a0b7e6fad809e4ede239f5fa1f155bce917f4d0194b412794e7cd14994"}, {"id": "RFC-BPR-0073:AC05", "source": "RFC-BPR-0073", "selector": "AC05", "source_fingerprint": "sha256:053820a0b7e6fad809e4ede239f5fa1f155bce917f4d0194b412794e7cd14994"}, {"id": "RFC-BPR-0073:AC06", "source": "RFC-BPR-0073", "selector": "AC06", "source_fingerprint": "sha256:053820a0b7e6fad809e4ede239f5fa1f155bce917f4d0194b412794e7cd14994"}, {"id": "RFC-BPR-0073:AC07", "source": "RFC-BPR-0073", "selector": "AC07", "source_fingerprint": "sha256:053820a0b7e6fad809e4ede239f5fa1f155bce917f4d0194b412794e7cd14994"}, {"id": "RFC-BPR-0073:AC08", "source": "RFC-BPR-0073", "selector": "AC08", "source_fingerprint": "sha256:053820a0b7e6fad809e4ede239f5fa1f155bce917f4d0194b412794e7cd14994"}], "obligation_fingerprint": "sha256:a2d9146706cf3fa18845d278ed704ec658caae1c22fc96ca4cbc2b09da325610", "exit_criteria": [{"id": "smooth-comparison-panning:exit:1", "text": "AC01: Rendered split and unified panes visibly apply, retain and reverse sub-line pixel motion without cumulative drift."}, {"id": "smooth-comparison-panning:exit:2", "text": "AC02: Repeated horizontal events around 20 pixels with at most 1 pixel vertical noise, horizontal reversal and clamping, and gesture end cause no vertical movement or delayed step."}, {"id": "smooth-comparison-panning:exit:3", "text": "AC03: Vertical-only and sustained diagonal input, within-gesture reorientation, input forwarding and gesture/device/comparison/presentation resets behave correctly."}, {"id": "smooth-comparison-panning:exit:4", "text": "AC04: Actual fractional viewport geometry aligns text, ribbons, gutters, marks, selection, pointer hits and conversation anchors at 100%, 125%, 200% and after code zoom."}, {"id": "smooth-comparison-panning:exit:5", "text": "AC05: Insertion pinning, unequal replacements, Home/End, scroll-past-end, pane handoff, angle fallback, Shift-wheel, zoom and semantic reveals preserve existing single-authority behavior."}, {"id": "smooth-comparison-panning:exit:6", "text": "AC06: A composed large-file course meets existing input budgets without semantic recomputation, unchanged-axis rebuild or whole-file text scan per event, observing real origins and geometry."}, {"id": "smooth-comparison-panning:exit:7", "text": "AC07: The owner accepts the exact self-contained frozen build through a fresh short attended-review session with the required Accept/Reject question and change note."}, {"id": "smooth-comparison-panning:exit:8", "text": "AC08: Split and unified arrows, repeat, Shift selection, pages and keyboard reveals remain discrete; viewport movement aligns the receiving presentation through the shared authority, cursor-only movement retains its fractional origin, and touchpad input resumes from the applied origin."}, {"id": "smooth-comparison-panning:exit:9", "text": "The new live RFC, adopted plan, canonical cards, baseline/provenance, semantic documentation, focused verification and closeout agree, with historical terminal evidence preserved."}], "prerequisite_fingerprint": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "structural": "valid", "references": "resolved", "semantic_coverage": "unknown", "diagnostics": [], "diagnostics_truncated": false}, "target_milestones": ["smooth-comparison-panning"], "repository_state": {"source_root": "/Users/jaeger/Documents/GitHub/BetterPullReview", "workflow_root": "/Users/jaeger/Documents/GitHub/BetterPullReview", "source_common_dir": "/Users/jaeger/Documents/GitHub/BetterPullReview/.git", "workflow_common_dir": "/Users/jaeger/Documents/GitHub/BetterPullReview/.git", "source_branch": "main", "source_revision": "7afbd357ecb8f4cae373b4d6a11bfb739511babb", "workflow_branch": "main", "workflow_revision": "7afbd357ecb8f4cae373b4d6a11bfb739511babb"}}
