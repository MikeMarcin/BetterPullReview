+		const auto active = TabsProjection.has_value()
+			&& std::ranges::any_of(TabsProjection->Tabs, &application::document_tab_entry::Active);
+		const auto wired = static_cast<bool>(DocumentTabDispatch);
+		if (NextTabAction != nullptr) {
