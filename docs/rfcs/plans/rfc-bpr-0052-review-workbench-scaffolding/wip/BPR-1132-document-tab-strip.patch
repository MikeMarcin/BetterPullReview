+	auto document_tab_strip::tab_at(const int aIndex) const -> std::optional<core::document_tab_id>
+	{
+		if (aIndex < 0 || static_cast<std::size_t>(aIndex) >= Shown.size()) {
+			return std::nullopt;
+		}
+		return Shown[static_cast<std::size_t>(aIndex)];
+	}
