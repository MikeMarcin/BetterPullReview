    "exit_criteria": [
      {
        "id": "overview-conversation-decisions:exit:1",
        "text": "Synthetic short, long and very long bodies distinguish provider admission from viewport limits and demonstrate the selected full-body reading interaction across representative widths, fonts and input methods."
      },
      {
        "id": "overview-conversation-decisions:exit:2",
        "text": "The reported drawer gap and clipped controls are identified, and the selected placement preserves drafts, explicit publication semantics and useful input space without changing authentication or publication authority."
      },
      {
        "id": "overview-conversation-decisions:exit:3",
        "text": "Thread loading, revealing, filtering, empty and failure states have a clear reachable interaction, and Discuss can present known PR-wide conversations without requiring a source comparison."
      },
      {
        "id": "overview-conversation-decisions:exit:4",
        "text": "Every design-only card records the selected design and an allocated linked implementation follow-up with runtime acceptance; investigation alone is not accepted as the RFC behavior."
      }
    ],
