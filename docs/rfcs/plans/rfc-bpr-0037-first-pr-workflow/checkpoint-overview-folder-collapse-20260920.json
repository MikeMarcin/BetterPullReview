    "exit_criteria": [
      {
        "id": "overview-folder-collapse:exit:1",
        "text": "Every folder, including ancestors of nested paths, exposes mouse and keyboard expand/collapse controls that hide all descendant files without opening a source comparison."
      },
      {
        "id": "overview-folder-collapse:exit:2",
        "text": "Reopening preserves file identities and order; collapsing or refreshing preserves sensible focus and selection without dispatching an unintended file selection."
      },
      {
        "id": "overview-folder-collapse:exit:3",
        "text": "Qt-local expansion survives an incremental same-authority refresh for surviving folders and is cleared when the owning pull-request authority is invalidated."
      },
      {
        "id": "overview-folder-collapse:exit:4",
        "text": "Focused nested-folder, refresh, keyboard and accessibility checks and a rendered public Overview course pass against the exact candidate, along with the documentation and board gates; all earlier accepted RFC criteria and canonical dependency gates remain preserved."
      }
    ],
