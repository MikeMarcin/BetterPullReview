    "exit_criteria": [
      {
        "id": "selected-diff-exact-epoch-pair:exit:1",
        "text": "BPR-0794 attributes selected_file_stale and the absent exact epoch pair with metadata-only evidence and tests the failure through the public composition"
      },
      {
        "id": "selected-diff-exact-epoch-pair:exit:2",
        "text": "The responsible transition or host mapping preserves exact authority, accepted anchor and Git-object checks, bounded history and stale-result rejection"
      },
      {
        "id": "selected-diff-exact-epoch-pair:exit:3",
        "text": "Focused positive and negative checks, a composed public path, documentation gate and one integration-focused check pass"
      },
      {
        "id": "selected-diff-exact-epoch-pair:exit:4",
        "text": "A tests-disabled Mac CLI-profile read of EpicGames/UnrealEngine#1773 shows the correct file list and readable selected diff with checked source and anchor identity; any remaining refusal remains open and explicit, with no live write or account change"
      },
      {
        "id": "selected-diff-exact-epoch-pair:exit:5",
        "text": "Every PR open paints a visible loading state promptly; small accepted reviews retain complete asynchronous background Git acquisition, while only large accepted reviews use bounded lazy selected-file and selected historical-epoch object acquisition"
      },
      {
        "id": "selected-diff-exact-epoch-pair:exit:6",
        "text": "BPR-0935 directly verifies keep dark-mode syntax legible across intraline edit emphasis, with exact candidate, regressions and rendered or measured public-path evidence"
      },
      {
        "id": "selected-diff-exact-epoch-pair:exit:7",
        "text": "BPR-0936 directly verifies render source tabs at the selected persisted width, with exact candidate, regressions and rendered or measured public-path evidence"
      },
      {
        "id": "selected-diff-exact-epoch-pair:exit:8",
        "text": "BPR-0937 directly verifies measure and reduce redundant cli connection work safely, with exact candidate, regressions and rendered or measured public-path evidence"
      },
      {
        "id": "selected-diff-exact-epoch-pair:exit:9",
        "text": "BPR-0938 directly verifies show useful overview observations before complete pr loading, with exact candidate, regressions and rendered or measured public-path evidence"
      },
      {
        "id": "selected-diff-exact-epoch-pair:exit:10",
        "text": "BPR-0939 directly verifies match file drawer added and removed colors to overview, with exact candidate, regressions and rendered or measured public-path evidence"
      },
      {
        "id": "selected-diff-exact-epoch-pair:exit:11",
        "text": "BPR-0941 keeps names neutral while operation markers and independent plus/minus counts use semantic colors, proven through rendered production composition across themes"
      },
      {
        "id": "selected-diff-exact-epoch-pair:exit:12",
        "text": "BPR-0942 makes folders structurally non-actionable for file selection and preserves the current diff across mouse, keyboard, expansion and model rebuild gestures"
      },
      {
        "id": "selected-diff-exact-epoch-pair:exit:13",
