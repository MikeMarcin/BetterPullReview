{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical implement-rfc card v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "status",
    "rfcs",
    "depends_on"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "implement-rfc.card.v1"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2,8}-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "Inbox",
        "Backlog",
        "Ready",
        "In Progress",
        "Parked",
        "Blocked",
        "Done"
      ]
    },
    "rfcs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^RFC-[A-Z]{2,8}(?:-[A-Z]{2,8})?-[0-9]{4}$"
      },
      "uniqueItems": true
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,8}-[0-9]{4}$"
      },
      "uniqueItems": true
    },
    "closeout_for": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^RFC-[A-Z]{2,8}(?:-[A-Z]{2,8})?-[0-9]{4}$"
      },
      "uniqueItems": true
    },
    "external_depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+:[A-Z]{2,8}-[0-9]{4}$"
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object"
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "outcome",
          "revision",
          "evidence"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "pending"
            ]
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "required": [
              "kind",
              "detail"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "command",
                  "observation",
                  "artifact",
                  "freeform"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "area": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "minLength": 1
    },
    "updated": {
      "type": "string",
      "minLength": 1
    },
    "completed": {
      "type": "string",
      "minLength": 1
    },
    "milestone": {
      "type": "string",
      "minLength": 1
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "parked_on": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "blocked_by": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    }
  }
}
