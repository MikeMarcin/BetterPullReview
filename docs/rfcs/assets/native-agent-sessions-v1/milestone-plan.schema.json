{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentskills:milestone-plan:v1",
  "title": "implement-rfc authored milestone plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "scope",
    "milestones"
  ],
  "properties": {
    "schema": {
      "const": "implement-rfc.milestone-plan.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 96
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rfcs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^RFC-[A-Z][A-Z0-9]*-[0-9]+$"
          }
        },
        "issues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "rfcs"
          ],
          "properties": {
            "rfcs": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "issues"
          ],
          "properties": {
            "issues": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "coverage": {
      "enum": [
        "complete",
        "partial"
      ],
      "default": "complete"
    },
    "unplanned_work": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work"
      },
      "uniqueItems": true,
      "default": []
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "outcome",
          "work",
          "depends_on",
          "exit_criteria",
          "boundary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "maxLength": 96
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "work": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/work"
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "maxLength": 96
            }
          },
          "exit_criteria": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "work": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issue": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$"
        },
        "rfc": {
          "type": "string",
          "pattern": "^RFC-[A-Z][A-Z0-9]*-[0-9]+$"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "issue"
          ],
          "not": {
            "required": [
              "rfc"
            ]
          }
        },
        {
          "required": [
            "rfc"
          ],
          "not": {
            "required": [
              "issue"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage": {
            "const": "partial"
          }
        },
        "required": [
          "coverage"
        ]
      },
      "then": {
        "required": [
          "unplanned_work"
        ],
        "properties": {
          "unplanned_work": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "unplanned_work": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
