// [[BPR-0974]]. The Windows version resource of one shipped image, generated by
// bpr_add_windows_version_resource() in cmake/BprWindowsImage.cmake.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @BPR_VERSION_RESOURCE_NUMBER@
 PRODUCTVERSION @BPR_VERSION_RESOURCE_NUMBER@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "@BPR_VENDOR_NAME@"
            VALUE "FileDescription", "@BPR_VERSION_RESOURCE_DESCRIPTION@"
            VALUE "FileVersion", "@BPR_RELEASE_DISPLAY_VERSION@"
            VALUE "InternalName", "@BPR_VERSION_RESOURCE_INTERNAL_NAME@"
            VALUE "OriginalFilename", "@BPR_VERSION_RESOURCE_FILE_NAME@"
            VALUE "ProductName", "@PROJECT_NAME@"
            VALUE "ProductVersion", "@BPR_RELEASE_DISPLAY_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
