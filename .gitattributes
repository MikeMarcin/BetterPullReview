# Auto detect text files and perform LF normalization
* text=auto

# Files whose exact bytes are pinned by a checked-in SHA-256 must not be
# transformed on checkout. `text=auto` above would hand a CRLF working tree to
# `file(SHA256)` in cmake/VerifyArchitectureBoundaries.cmake and to
# `hashlib.sha256` in tests/scripts/app_icon_assets_tests.py, so the pin — which
# is computed over the LF blob — would fail on Windows and hold on POSIX. See
# BPR-0359.
tests/network_isolation/designated_live_mutation_canary.cpp text eol=lf
tests/network_isolation/designated_live_mutation_canary.hpp text eol=lf
tests/network_isolation/designated_live_mutation_child.cpp text eol=lf
tests/network_isolation/designated_live_mutation_child.hpp text eol=lf
packaging/icons/better_pull_review.svg text eol=lf

# The Dif asset canon regenerates each document and compares bytes, and its
# canonical form ends every line with LF. A CRLF working tree can never equal
# it, so `dif_assets.py` rejects its own checked-in assets. The PNGs are
# deliberately absent: git already classifies them as binary and a text
# attribute would corrupt them. See BPR-0365.
src/adapters/qt/assets/dif/README.md text eol=lf
src/adapters/qt/assets/dif/dif-sprite-manifest.json text eol=lf
src/adapters/qt/assets/dif/provenance.json text eol=lf
src/adapters/qt/assets/dif/generated/dif-sprite-catalog.hpp text eol=lf
src/adapters/qt/assets/dif/generated/dif-sprite-digests.json text eol=lf

# The GitHub contract and capability fixtures have their exact bytes pinned by
# constants in tests/scripts/github_contract_fixture_security_tests.py, which
# hashes what it reads from disk. A CRLF checkout changes every one of them. The
# pack file is deliberately absent: git classifies it as binary already. See
# BPR-0372.
tests/fixtures/github/**/*.json text eol=lf
tests/fixtures/github/**/*.md text eol=lf
